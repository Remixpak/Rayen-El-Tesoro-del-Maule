  m_Script: {fileID: 11500000, guid: a7ebfa04b912309468024c8b6fce7787, type: 3}
  m_Name: MisionPihuchen
  m_EditorClassIdentifier: Assembly-CSharp::ConversationTemplate
  conversationLines:
  - speakerName: "Ray\xE9n"
    DialogText: "Ya los venc\xED"
    speakerSprite: {fileID: 21300000, guid: cafd5fbb74c4d5848b6698bc691d912e, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: "As\xED parece muchacha"
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: La primera bestia que debes derrotar se trata del temible pihuchen
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: "pero no aparecer\xE1 hasta que destruyas a sus 3 crias escondidas.
      Estas tienen forma de animales comunes"
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: "La primera est\xE1 en el pueblo, la segunda en el bosque, y la tercera... "
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: "No lo recuerdo, tendr\xE1s que investigar "
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
  - speakerName: Novia de Perpilen
    DialogText: "vuelve cuando lo hayas derrotado y te abrir\xE9 la puerta a lo m\xE1s
      profundo del bosque."
    speakerSprite: {fileID: 21300000, guid: 9c58ebb51cd31864b8c4837723ca7ffb, type: 3}
